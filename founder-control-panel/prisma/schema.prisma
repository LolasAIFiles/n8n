generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String
  createdAt          DateTime             @default(now())
  mission            Mission?
  projects           Project[]
  weeklyReviews      WeeklyReview[]
  ideas              Idea[]
  ideaEvaluations    IdeaEvaluation[]
  provenanceLogs     AIProvenanceLog[]
  blueprints         Blueprint[]
  compressionRuns    CompressionRun[]
  listings           MarketplaceListing[]
  automationProgress AutomationProgress[]
  killSwitchStates   KillSwitchState[]
}

model Mission {
  id         String   @id @default(uuid())
  userId     String   @unique
  missionText String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String
  status      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyReview {
  id          String   @id @default(uuid())
  userId      String
  wins        Json
  energyScore Int
  stressScore Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Idea {
  id                String           @id @default(uuid())
  userId            String
  title             String
  description       String
  problemSolved     String
  targetCustomer    String
  industry          String
  notes             String
  status            String           @default("UNTRIAGED")
  monetizationStatus String          @default("UNDECIDED")
  lifeAlignmentStatus String         @default("UNASSESSED")
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags              IdeaTag[]
  evaluations       IdeaEvaluation[]
  blueprints        Blueprint[]
}

model IdeaTag {
  id       String @id @default(uuid())
  ideaId   String
  name     String
  idea     Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model IdeaEvaluation {
  id             String   @id @default(uuid())
  userId         String
  ideaId         String
  mode           String
  inputPayload   Json
  score          Int
  recommendation String
  reasoning      String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea           Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model AIProvenanceLog {
  id               String   @id @default(uuid())
  userId           String
  action           String
  model            String
  promptVersion    String
  inputPayload     Json
  outputPayload    Json
  relatedEntityType String?
  relatedEntityId  String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Blueprint {
  id                String   @id @default(uuid())
  userId            String
  ideaId            String
  output            Json
  model             String
  promptVersion     String
  pdfUrl            String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea              Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model CompressionRun {
  id             String   @id @default(uuid())
  userId         String
  inputIdeaIds   Json
  output         Json
  model          String
  promptVersion  String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketplaceListing {
  id               String   @id @default(uuid())
  userId           String
  blueprintId      String?
  title            String
  description      String
  price            Decimal
  licenseType      String
  deliveryType     String
  status           String
  platformFeePercent Int
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AutomationProgress {
  id             String   @id @default(uuid())
  userId         String
  engine         String
  checklist      Json
  completionRate Float
  nextStep       String
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, engine])
}

model KillSwitchState {
  id         String   @id @default(uuid())
  userId     String
  sessionId  String
  active     Boolean
  priority   String
  nextAction String
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}
